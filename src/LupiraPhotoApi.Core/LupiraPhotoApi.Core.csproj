<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the LupiraPhotoApi.* namespaces unchanged across the project split. -->
    <RootNamespace>LupiraPhotoApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LupiraPhotoApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bounded context: Domain (identity, photo assets, key scheme, lifecycle), Application (services +
         OpResult), Dtos, and the vendor-neutral IObjectStore seam. Bytes live in the object store; Marten holds
         only asset documents on the `photo` schema. No ASP.NET dependency — that lives in the host. -->
    <PackageReference Include="Marten" Version="9.10.0" />
  </ItemGroup>

</Project>
